# 0-15: the list's nominal values. Each terminal theme redefines these, so they
# describe what the colors are meant to be, not what you'll see.
BASIC_RGB = [
  (0, 0, 0), (128, 0, 0), (0, 128, 0), (128, 128, 0),
  (0, 0, 128), (128, 0, 128), (0, 128, 128), (192, 192, 192),
  (128, 128, 128), (255, 0, 0), (0, 255, 0), (255, 255, 0),
  (0, 0, 255), (255, 0, 255), (0, 255, 255), (255, 255, 255),
]
BASIC_CAVEAT = ('* 0-15 are redefined by each terminal theme, so how they look\n'
                '  (and their real RGB values) vary from terminal to terminal.')

CUBE_LEVELS = [0, 95, 135, 175, 215, 255]

# A red prompt means the last command failed, so the normal prompt color must
# never be mistaken for red. These are never offered for the prompt:
#   * reds and their near neighbors: HSV hue within 28 degrees above or 45
#     below pure red, at saturation >= 0.30 (maroons, crimsons, red-oranges,
#     red-pinks)
#   * anything too dark to read on a black background (relative luminance
#     below 0.10: the darkest blues, greens and purples, and the bottom of the
#     gray ramp)
#   * 0-15, whose look depends on the terminal theme
# Computed once and pasted in, rather than computed every time.
PROMPT_EXCLUDED = set(range(0, 16)) | {
  16, 17, 18, 19, 20, 21, 22, 23, 24, 52, 53, 54, 55, 56, 57, 88, 89, 90, 91,
  124, 125, 131, 132, 160, 161, 162, 166, 167, 168, 169, 173, 174, 175, 196,
  197, 198, 199, 202, 203, 204, 205, 206, 209, 210, 211, 212, 216, 217, 218,
  232, 233, 234, 235, 236, 237, 238, 239, 240,
}


def rgb(color):
  if color < 16:
    return BASIC_RGB[color]
  if color >= 232:
    level = 8 + 10 * (color - 232)
    return (level, level, level)
  cube = color - 16
  return (CUBE_LEVELS[cube // 36], CUBE_LEVELS[cube // 6 % 6], CUBE_LEVELS[cube % 6])


def prompt_ok(color):
  return 0 <= color <= 255 and color not in PROMPT_EXCLUDED


# SGR codes for the text attributes.
BOLD, DIM, ITALIC, UNDERLINE, INVERSE = '1', '2', '3', '4', '7'


def styled(s, color=None, attributes=()):
  """s in the given color (None: terminal default) and attributes, then reset."""
  codes = list(attributes)
  if color is not None:
    codes.append('38;5;{}'.format(color))
  if not codes:
    return s
  return '\033[{}m{}\033[0m'.format(';'.join(codes), s)


def cell(color, shown, attributes):
  """A grid cell: the color's number drawn in itself, or blank if not shown."""
  if not shown(color):
    return '    '
  return styled('{:4d}'.format(color), color, attributes)


def show_grid(shown, attributes):
  lines = []
  # 0-15, as two rows of eight.
  if any(shown(c) for c in range(16)):
    for row in range(2):
      lines.append(''.join(cell(row * 8 + col, shown, attributes) for col in range(8)) + ' *')
    lines.append('')
  # The 6x6x6 cube (16-231), as two bands of three 6x6 blocks.
  for band in range(2):
    for row in range(6):
      line = ''
      for block in range(3):
        for col in range(6):
          line += cell(16 + (band * 3 + block) * 36 + row * 6 + col, shown, attributes)
        line += '  '
      lines.append(line.rstrip())
    lines.append('')
  # The gray ramp (232-255), as two rows of twelve.
  for row in range(2):
    lines.append(''.join(cell(232 + row * 12 + col, shown, attributes) for col in range(12)))
  if any(shown(c) for c in range(16)):
    lines.append('')
    lines.append(BASIC_CAVEAT)
  print('\n'.join(lines))


def show_attribute_samples():
  colors = [None, 1, 196, 34, 33, 245]
  headings = ['default', '1', '196', '34', '33', '245']
  rows = [
    ('normal', []),
    ('bold', [BOLD]),
    ('dim', [DIM]),
    ('italic', [ITALIC]),
    ('underline', [UNDERLINE]),
    ('inverse', [INVERSE]),
    ('bold+dim', [BOLD, DIM]),
    ('bold+italic', [BOLD, ITALIC]),
    ('bold+inverse', [BOLD, INVERSE]),
  ]
  print()
  print('{:15}'.format('') + ''.join('{:10}'.format(h) for h in headings))
  for label, attributes in rows:
    print('{:15}'.format(label) + ''.join(styled('Sample', c, attributes) + '    ' for c in colors))
  # How the terminal handles turning bold off. 22 is the correct code; some
  # terminals treat 21 as double underline instead.
  print()
  print('{:15}'.format('bold, then 22') + '\033[1mbold\033[22m normal  (correct: second word normal)')
  print('{:15}'.format('bold, then 21') + '\033[1mbold\033[21m ?\033[0m       (21 is often double underline)')


def entry(color):
  r, g, b = rgb(color)
  marker = '*' if color < 16 else ' '
  return '{:3d} {:17} {:3d},{:3d},{:3d}{}'.format(color, NAMES[color], r, g, b, marker)


def show_names(shown, attributes):
  colors = [c for c in range(256) if shown(c)]
  if not sys.stdout.isatty():
    # One plain entry per line, for grep.
    for color in colors:
      print(entry(color).rstrip())
    return
  width = len(entry(0))
  gap = 3
  terminal_width = shutil.get_terminal_size().columns
  columns = max(1, (terminal_width + gap) // (width + gap))
  rows = (len(colors) + columns - 1) // columns
  # Down each column, then across, like ls.
  for row in range(rows):
    parts = []
    for col in range(columns):
      index = col * rows + row
      if index < len(colors):
        parts.append(styled(entry(colors[index]), colors[index], attributes))
    print((' ' * gap).join(parts))
  if any(c < 16 for c in colors):
    print()
    print(BASIC_CAVEAT)


def main():
  parser = argparse.ArgumentParser(
      description="Show the terminal's 256 colors and how it renders them. "
                  "With no options: all 256 colors, plus attribute samples.")
  parser.add_argument('-g', action='store_true', help='only the colors allowed for the prompt')
  parser.add_argument('-n', action='store_true', help='list number, name and RGB instead of a grid')
  parser.add_argument('-b', action='store_true', help='bold')
  parser.add_argument('-d', action='store_true', help='dim')
  parser.add_argument('-I', action='store_true', help='italic')
  parser.add_argument('-u', action='store_true', help='underline')
  parser.add_argument('-i', action='store_true', help='inverse')
  parser.add_argument('--prompt-ok', type=int, metavar='N',
                      help='exit 0 if N may be used as a prompt color (for install)')
  parser.add_argument('--prompt-colors', action='store_true',
                      help='print the prompt colors, one per line (for install)')
  args = parser.parse_args()

  if args.prompt_ok is not None:
    sys.exit(0 if prompt_ok(args.prompt_ok) else 1)
  if args.prompt_colors:
    for color in range(256):
      if prompt_ok(color):
        print(color)
    return

  attributes = []
  for flag, code in ((args.b, BOLD), (args.d, DIM), (args.I, ITALIC),
                     (args.u, UNDERLINE), (args.i, INVERSE)):
    if flag:
      attributes.append(code)

  if args.g:
    shown = prompt_ok
  else:
    shown = lambda color: True

  if args.n:
    show_names(shown, attributes)
  else:
    show_grid(shown, attributes)
    if not args.g:
      show_attribute_samples()


main()
