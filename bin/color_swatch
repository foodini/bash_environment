#!/usr/bin/env python3
# coding: utf-8
#
# color_swatch: look at the terminal's 256 colors and how it renders them.
#
# usage: color_swatch [-g] [-n] [-b] [-d] [-I] [-u] [-i]
#
#   (default) grid of all 256 colors, followed by samples of each text
#        attribute
#   -g   only the colors allowed for the prompt (no attribute samples)
#   -n   list number, name and RGB value instead of a grid
#   -b -d -I -u -i
#        draw in bold, dim, italic, underline, inverse (combinable, e.g. -bu)
#
#   With -n, output to a terminal is in columns sized to the window; output
#   to a pipe or file is one plain, uncolored entry per line, for grep.
#
# For install:
#   --prompt-ok N      exit 0 if N may be used as a prompt color
#   --prompt-colors    print the colors allowed for the prompt, one per line
#
# Assumes a black background.
#
# Color names: the de facto xterm list, from https://github.com/jonasjacek/colors
# (CC BY-SA 4.0). Names repeat (19 and 20 are both Blue3), so search by name
# or RGB, but refer to colors by number.
#
# TODO: The Mac is still on python 3.9. Keep this 3.9-compatible until every
#       machine runs 3.10+.

import argparse
import shutil
import sys

NAMES = [
  'Black', 'Maroon', 'Green', 'Olive', 'Navy', 'Purple',  # 0-5
  'Teal', 'Silver', 'Grey', 'Red', 'Lime', 'Yellow',  # 6-11
  'Blue', 'Fuchsia', 'Aqua', 'White', 'Grey0', 'NavyBlue',  # 12-17
  'DarkBlue', 'Blue3', 'Blue3', 'Blue1', 'DarkGreen', 'DeepSkyBlue4',  # 18-23
  'DeepSkyBlue4', 'DeepSkyBlue4', 'DodgerBlue3', 'DodgerBlue2', 'Green4', 'SpringGreen4',  # 24-29
  'Turquoise4', 'DeepSkyBlue3', 'DeepSkyBlue3', 'DodgerBlue1', 'Green3', 'SpringGreen3',  # 30-35
  'DarkCyan', 'LightSeaGreen', 'DeepSkyBlue2', 'DeepSkyBlue1', 'Green3', 'SpringGreen3',  # 36-41
  'SpringGreen2', 'Cyan3', 'DarkTurquoise', 'Turquoise2', 'Green1', 'SpringGreen2',  # 42-47
